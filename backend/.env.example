# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Core (required) ---
MONGO_URI=
JWT_SECRET=
PORT=5000
NODE_ENV=development

# --- Cloudinary (photo/media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — only set if a paid Cloudinary moderation add-on is enabled
# (Cloudinary dashboard -> Add-ons -> "aws_rek" or "webpurify").
CLOUDINARY_MODERATION=

# --- Gmail SMTP (password reset / email verification codes) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Networking / security ---
# Must be reachable by the phone's browser (matches EXPO_PUBLIC_API_URL's host).
# Used to build eSewa/Khalti redirect URLs.
BACKEND_PUBLIC_URL=http://localhost:5000
# Comma-separated list of allowed browser origins for CORS. Leave unset for "*".
ALLOWED_ORIGINS=
# Set to "true" only when actually deployed behind a trusted reverse proxy/load
# balancer (needed for rate limiting and req.ip to see the real client IP).
TRUST_PROXY=false

# --- Referral / deep linking ---
# Matches the "scheme" in frontend/app.json.
APP_DEEP_LINK_SCHEME=datingapp

# --- Premium subscription ---
PREMIUM_PLAN_PRICE_NPR=500

# --- eSewa payment gateway ---
# Defaults below are eSewa's public UAT sandbox test credentials — safe to
# leave as-is for testing. Replace with real merchant credentials in
# production (register at https://merchant.esewa.com.np).
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# --- Khalti payment gateway ---
# Required for the Khalti button to work. Get a key from
# https://khalti.com -> Merchant/Business signup -> Dashboard -> Keys.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# --- Google Sign-In ---
# Get an OAuth Client ID from https://console.cloud.google.com -> APIs &
# Services -> Credentials. Must match EXPO_PUBLIC_GOOGLE_CLIENT_ID in
# frontend/.env. Leaving this blank skips audience verification (Google
# Sign-In still works, just less strictly validated).
GOOGLE_CLIENT_ID=
